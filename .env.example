# Local development template.
# Runtime precedence is: hardcoded defaults -> config/default.yaml -> .env -> real environment variables.
# Production should inject real environment variables or platform secrets instead of relying on this file.

# Server
# 本地开发默认约定后端监听 18080，前端脚本默认连 http://127.0.0.1:18080
SERVER_PORT=18080

# Database
# Required for server startup. Keep real values out of git.
DATABASE_URL=postgres://username:password@db-host:5432/agent_project?sslmode=disable

# SiliconFlow AI
# Optional for startup, required for real embedding/search requests.
SILICONFLOW_API_KEY=sk-your-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Pro/deepseek-ai/DeepSeek-V3.2
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1024
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# Document parsing
# 默认 text：仅直通 md/txt。若要解析 doc/docx/pdf/rtf/odt，请切到 tika 并提供 Tika Server 地址。
DOCUMENT_PARSER=text
TIKA_URL=http://127.0.0.1:9998
TIKA_TIMEOUT_MS=30000

# Retrieval
# 默认仍走 PostgreSQL 词法召回；只有切到 opensearch_bm25 时才要求 OpenSearch 可用。
SEARCH_BACKEND=postgres_legacy
LEXICAL_SEARCH_ENABLED=true
SEMANTIC_HNSW_ENABLED=true
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX_CHUNKS=resource_chunks_v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_TLS_INSECURE=false
# 本地 docker compose 默认关闭安全插件，通常无需额外用户名密码。
# 如果后续改为启用安全插件，请同时设置 OPENSEARCH_INITIAL_ADMIN_PASSWORD 并把上面的用户名/密码改成真实值。

# Uploads
# 原始上传文件会保存到项目根目录下的 data/uploads。
UPLOAD_STORAGE_DIR=data/uploads
UPLOAD_MAX_BYTES=20971520
